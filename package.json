{
  "name": "vinyaas-monorepo",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Sarang Kumar",
    "url": "https://github.com/SarangKumar"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "lint": "pnpm --filter docs lint",
    "typecheck": "pnpm --filter docs typecheck",
    "test": "pnpm --filter docs test:run",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:integration": "node packages/cli/integration/registry.mjs",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "pnpm --filter docs exec eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15"
  }
}
