{
  "name": "vinyaas",
  "version": "1.3.2",
  "description": "Registry-driven React component CLI that installs customizable Tailwind CSS v4 UI as source into your project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vinyaas": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://vinyaas.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarangKumar/vinyaas.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SarangKumar/vinyaas/issues"
  },
  "keywords": [
    "vinyaas",
    "react",
    "components",
    "react-components",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "shadcn",
    "ui-library",
    "design-system",
    "cli",
    "registry",
    "typescript"
  ],
  "author": {
    "name": "Sarang Kumar",
    "url": "https://github.com/SarangKumar"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsx ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test",
    "start": "node dist/index.js",
    "prepublishOnly": "node ./scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
