{
  "name": "vinyaas",
  "version": "1.0.0",
  "description": "Command-line interface for installing Vinyaas components.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vinyaas": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://www.npmjs.com/package/vinyaas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarangKumar/vinyaas.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SarangKumar/vinyaas/issues"
  },
  "keywords": [
    "vinyaas",
    "cli",
    "react",
    "tailwindcss",
    "components",
    "registry",
    "ui"
  ],
  "author": {
    "name": "Sarang Kumar",
    "url": "https://github.com/SarangKumar"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
