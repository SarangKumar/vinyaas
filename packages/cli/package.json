{
  "name": "@vinyas/cli",
  "version": "0.0.1",
  "description": "Command-line interface for installing Vinyas components.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vinyas": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Sarang Kumar",
    "url": "https://github.com/SarangKumar"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
