{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vinyas components.json",
  "description": "Consumer project configuration for installing Vinyas components.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "style", "tsx", "tailwind", "aliases"],
  "properties": {
    "$schema": {
      "description": "URL of this schema.",
      "type": "string",
      "minLength": 1
    },
    "style": {
      "description": "Vinyas style to install.",
      "type": "string",
      "enum": ["new-york"]
    },
    "tsx": {
      "description": "Emit TypeScript components when true, and JavaScript when false.",
      "type": "boolean"
    },
    "tailwind": {
      "description": "Styling configuration for the consumer project.",
      "type": "object",
      "additionalProperties": false,
      "required": ["css", "baseColor", "cssVariables"],
      "properties": {
        "css": {
          "description": "Global CSS file, relative to the consumer project.",
          "type": "string",
          "minLength": 1
        },
        "baseColor": {
          "description": "Base palette name used when CSS variables are installed.",
          "type": "string",
          "minLength": 1
        },
        "cssVariables": {
          "description": "Install colors as CSS variables when true.",
          "type": "boolean"
        }
      }
    },
    "aliases": {
      "description": "Import aliases the CLI uses when writing installed files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "ui", "lib", "utils", "hooks"],
      "properties": {
        "components": {
          "type": "string",
          "minLength": 1
        },
        "ui": {
          "type": "string",
          "minLength": 1
        },
        "lib": {
          "type": "string",
          "minLength": 1
        },
        "utils": {
          "description": "Import specifier for the cn helper, such as @/lib/utils.",
          "type": "string",
          "minLength": 1
        },
        "hooks": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
