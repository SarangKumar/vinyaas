{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shilp Registry Item",
  "type": "object",
  "required": ["name", "type", "files"],
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array"
    }
  }
}
