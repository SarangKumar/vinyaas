{
  "id": "nyx",
  "name": "Nyx",
  "type": "shade",
  "description": "A soft shadow that glows in the dark.",
  "lore": "Condensed from the space between pixels after sundown, Nyx slipped into the docs looking for a quiet perch. It drinks in dark mode, glows when the theme flips, and leaves a violet hush wherever it lands.",
  "personalityTraits": [
    "quiet",
    "loyal",
    "nocturnal"
  ],
  "capabilities": {
    "floating": true,
    "followCursor": true,
    "reactToClick": true
  },
  "instances": {
    "eclipse": {
      "name": "Eclipse",
      "personalityTraits": [
        "bold",
        "nocturnal",
        "curious"
      ],
      "moodBias": "excited",
      "behavior": {
        "energy": "high",
        "idleTimeoutMs": 28000,
        "cursorNearbyRadius": 160
      }
    },
    "umbra": {
      "name": "Umbra",
      "personalityTraits": [
        "calm",
        "quiet",
        "loyal"
      ],
      "moodBias": "sleepy",
      "behavior": {
        "energy": "calm",
        "idleTimeoutMs": 36000,
        "cursorNearbyRadius": 100
      }
    }
  },
