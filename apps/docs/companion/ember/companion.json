{
  "id": "ember",
  "name": "Ember",
  "type": "flame",
  "description": "A tiny playful flame spirit.",
  "lore": "Born from the lava of a restless volcano, Ember hopped onto cooler stone and never looked back. It warms desks, scorches boredom, and still smells faintly of ash and summer lightning.",
  "personalityTraits": ["playful", "curious", "energetic"],
  "capabilities": {
    "floating": true,
    "followCursor": false,
    "reactToClick": true
  },
  "instances": {
    "spark": {
      "name": "Spark",
      "personalityTraits": ["energetic", "bold", "bright"],
      "moodBias": "excited",
      "behavior": {
        "energy": "high",
        "idleTimeoutMs": 30000,
        "cursorNearbyRadius": 140
      }
    },
    "ash": {
      "name": "Ash",
      "personalityTraits": ["calm", "gentle", "warm"],
      "moodBias": "sleepy",
      "behavior": {
        "energy": "calm",
        "idleTimeoutMs": 30000,
        "cursorNearbyRadius": 90
      }
    }
  },
  "interactions": [
    {
      "id": "react-click",
      "description": "Reacts when clicked",
      "trigger": "click",
      "action": "play_animation",
      "animation": "happy",
      "cooldown": 900,
      "duration": 1800
    },
    {
      "id": "jump",
      "description": "Bounces upward with heat",
      "trigger": "double_click",
      "action": "jump",
      "animation": "happy",
      "cooldown": 1200,
      "duration": 900
    },
    {
      "id": "sleep",
      "description": "Dims and dozes off",
      "trigger": "idle_timeout",
      "action": "sleep",
      "animation": "sleep",
      "cooldown": 6000,
      "duration": 4200
    },
    {
      "id": "idle",
      "description": "Softly flickers while waiting",
      "trigger": "idle_timeout",
      "action": "play_animation",
      "animation": "idle",
      "cooldown": 0,
      "duration": 2800
    },
    {
      "id": "fall",
      "description": "Falls after being dropped",
      "trigger": "drop",
      "action": "change_state",
      "state": "falling",
      "animation": "fall",
      "cooldown": 0
    },
    {
      "id": "drag-start",
      "description": "Settles when picked up",
      "trigger": "drag_start",
      "action": "play_animation",
      "animation": "idle",
      "cooldown": 0
    },
    {
      "id": "nearby",
      "description": "Notices a nearby cursor",
      "trigger": "cursor_nearby",
      "action": "play_animation",
      "animation": "happy",
      "cooldown": 2500,
      "duration": 1200
    },
    {
      "id": "page-hello",
      "description": "Greets after navigation",
      "trigger": "page_navigation",
      "action": "play_animation",
      "animation": "happy",
      "cooldown": 4000,
      "duration": 1400
    },
    {
      "id": "scroll-glance",
      "description": "Glances when the page scrolls",
      "trigger": "scroll",
      "action": "play_animation",
      "animation": "idle",
      "cooldown": 2200,
      "duration": 900
    },
    {
      "id": "celebrate",
      "description": "Bursts brighter in joy",
      "trigger": "click",
      "action": "play_animation",
      "animation": "celebrate",
      "cooldown": 1200,
      "duration": 1800
    },
    {
      "id": "wake",
      "description": "Flare-wakes from a nap",
      "trigger": "click",
      "action": "change_state",
      "state": "idle",
      "animation": "idle",
      "cooldown": 400
    },
    {
      "id": "blink",
      "description": "Blinks with bright ember eyes",
      "trigger": "idle_timeout",
      "action": "play_animation",
      "animation": "blink",
      "cooldown": 5000,
      "duration": 500
    },
    {
      "id": "wiggle",
      "description": "Wiggles with a happy squash",
      "trigger": "surface_action",
      "action": "play_animation",
      "animation": "wiggle",
      "cooldown": 1400,
      "duration": 1400
    },
    {
      "id": "dance",
      "description": "Dances happily on command",
      "trigger": "scroll",
      "action": "play_animation",
      "animation": "dance",
      "duration": 1800,
      "cooldown": 2800
    },
    {
      "id": "spin",
      "description": "Spins like a tiny spark",
      "trigger": "page_navigation",
      "action": "play_animation",
      "animation": "spin",
      "cooldown": 4500,
      "duration": 1600
    },
    {
      "id": "surprise",
      "description": "Pops up in surprise",
      "trigger": "double_click",
      "action": "jump",
      "animation": "surprise",
      "cooldown": 1400,
      "duration": 1400
